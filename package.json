{
  "name": "forestshop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @forestshop/api test:integration",
    "catalog:ingest": "tsx scripts/catalog-ingest.ts",
    "catalog:prune-raw": "tsx scripts/catalog-prune-raw.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "zod": "^3.24.0"
  }
}
